rules_version = '2';

// This is the real access-control layer for the site — not the client-side
// `hd` sign-in hint or `isAllowedEmail()` check in assets/js/auth.js, both
// of which are UX niceties only. Firebase Auth verifies the Google sign-in
// server-side and attaches the verified email to request.auth.token, so
// checking it here is real, tamper-proof enforcement.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedDomain() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@email\\.vccs\\.edu$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin status is a Firestore allowlist, not a custom claim (no Cloud
    // Functions in this project to set claims). A doc existing at
    // admins/{uid} means that account is an admin — added/removed only via
    // the Firebase console's Data tab, never through client writes (see the
    // admins collection rule below).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A user can always read their OWN admin doc (so the client can check
    // "am I an admin" and get a clean not-found rather than a permission
    // error) but never anyone else's. `isAdmin()` above uses exists(),
    // which checks Firestore directly and isn't subject to this read rule,
    // so authorization elsewhere doesn't depend on this being permissive.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if (isOwner(userId) && isAllowedDomain()) || isAdmin();

      // Created once on first sign-in; profile fields aren't editable by
      // the owner afterward in this trial, so no owner update rule exists.
      // Admins can update (e.g. fix a display name).
      allow create: if isOwner(userId) && isAllowedDomain()
        && request.resource.data.keys().hasAll(['email', 'display_name', 'created_at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() <= 200;

      allow update: if isAdmin();
      allow delete: if false;

      match /attendance/{eventId} {
        allow read: if (isOwner(userId) && isAllowedDomain()) || isAdmin();

        // The doc ID *is* the event ID, so this path is the duplicate
        // checkin guard: once a doc exists here, Firestore treats any
        // further write to it as an update, which is denied below.
        allow create: if isOwner(userId) && isAllowedDomain()
          && eventId.size() > 0 && eventId.size() <= 100
          && request.resource.data.keys().hasAll(['timestamp']);

        // Admins can remove a mistaken check-in.
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Authorizes admin-only collectionGroup('attendance') queries used by
    // the metrics dashboard, without touching the specific per-user rules
    // above (both rule blocks are evaluated; either can grant access).
    match /{path=**}/attendance/{attendanceId} {
      allow read: if isAdmin();
    }

    // Anonymous Speak Up submissions: write-only for the public, read-only
    // for admins (so officers can actually see feedback and metrics can
    // count it).
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (!('nomination' in request.resource.data)
            || (request.resource.data.nomination is string
                && request.resource.data.nomination.size() <= 500));

      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Events: publicly readable (Show Up needs this with no sign-in),
    // admin-only write. Replaces the old static EVENTS config array.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Spotlight drafts: admin-only in both directions. The public Shout
    // Out page does not read this collection yet — draft-only, for
    // presentation purposes, per the current phase's scope.
    match /spotlights/{spotlightId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
