rules_version = '2';

// Placeholder — default-deny everything. Real access rules (domain-restricted
// user/attendance access, create-only feedback) land in Phase 4, alongside
// the smoke test that verifies they actually work before any real page
// depends on them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
